{
    "endOfLine": "lf",
    "semi": true,
    "singleQuote": true,
    "tabWidth": 4,
    "trailingComma": "es5",
    "printWidth": 80,
    "useTabs": false,
    "plugins": ["prettier-plugin-tailwindcss"],
    "tailwindStylesheet": "src/index.css",
    "tailwindFunctions": ["cn", "cva"],
    "arrowParens": "always",
    "bracketSpacing": true
}
