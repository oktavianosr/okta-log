{
  "kind": "collectionType",
  "collectionName": "posts",
  "info": { "singularName": "post", "pluralName": "posts", "displayName": "Post" },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true, "unique": true },
    "excerpt": { "type": "text", "required": true },
    "body": { "type": "text" },
    "kind": { "type": "enumeration", "enum": ["article", "update", "solution"], "required": true },
    "activityDate": { "type": "datetime", "required": true },
    "featured": { "type": "boolean", "default": false },
    "cover": { "type": "media", "multiple": false, "required": false, "allowedTypes": ["images"] },
    "project": { "type": "relation", "relation": "manyToOne", "target": "api::project.project", "inversedBy": "posts" },
    "tags": { "type": "relation", "relation": "manyToMany", "target": "api::tag.tag", "inversedBy": "posts" }
  }
}
